// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 Int      @id @default(autoincrement())
  email              String   @unique
  password           String
  fullName           String?
  faculty            String?
  registrationNumber String?
  suspendedUntil     DateTime?
  suspensionReason   String?
  isDeleted          Boolean  @default(false)
  deletionReason     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  notifications      Notification[]
  reports            Report[]
  savedPosts         SavedPost[]
  events             Event[]
  wikiArticles       WikiArticle[]
  interests          String[]  @default([])
  galleryItems       GalleryItem[]
}


model Moderator {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  fullName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actions   ModerationAction[]
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  type      String   // e.g., 'WARNING', 'INFO'
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ModerationAction {
  id           Int      @id @default(autoincrement())
  moderatorId  Int?
  moderator    Moderator? @relation(fields: [moderatorId], references: [id])
  targetUserId Int
  actionType   String   // 'WARN', 'SUSPEND', 'DELETE'
  reason       String?
  durationDays Int?     // For suspensions, in days
  createdAt    DateTime @default(now())
}

// ─── Forum Models ──────────────────────────────────────────────────────────────

model ForumPost {
  id           Int       @id @default(autoincrement())
  authorId     Int
  title        String
  content      String
  faculty      String?   // Used for FACULTY_ONLY and BATCH_ONLY scoping
  batch        String?   // e.g. "E23" – only relevant for BATCH_ONLY
  visibility   String    // 'UNIVERSITY_WIDE' | 'FACULTY_ONLY' | 'BATCH_ONLY'
  isAnonymous  Boolean   @default(false)
  upvotes      Int       @default(0)
  isFlagged    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  comments     Comment[]
  votes        PostVote[]
  savedBy      SavedPost[]
  tags         String[]  @default([])
}

model Comment {
  id          Int       @id @default(autoincrement())
  postId      Int
  post        ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId    Int
  content     String
  isAnonymous Boolean   @default(false)
  isFlagged   Boolean   @default(false)
  createdAt   DateTime  @default(now())
}

model PostVote {
  id      Int       @id @default(autoincrement())
  postId  Int
  post    ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId  Int
  value   Int       // 1 for upvote, -1 for downvote

  @@unique([postId, userId])
}

model SavedPost {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    Int
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  savedAt   DateTime  @default(now())

  @@unique([userId, postId])
}

// ─── Reporting System ───────────────────────────────────────────────────────────

model Report {
  id          Int      @id @default(autoincrement())
  reporterId  Int
  reporter    User     @relation(fields: [reporterId], references: [id])
  contentType String   // 'POST' | 'COMMENT'
  contentId   Int
  reason      String   // 'SPAM' | 'HARASSMENT' | 'MISINFORMATION' | 'INAPPROPRIATE' | 'DUPLICATE' | 'OTHER'
  description String?  // Optional extra detail from reporter
  status      String   @default("PENDING")  // 'PENDING' | 'UNDER_REVIEW' | 'RESOLVED' | 'REJECTED'
  modNote     String?  // Moderator's internal note
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([reporterId, contentType, contentId])  // Prevent duplicate reports
}

// ─── Events ──────────────────────────────────────────────────────────────────

model Event {
  id            Int      @id @default(autoincrement())
  title         String
  description   String
  eventDate     DateTime
  eventTime     String
  location      String
  link          String?
  imageUrl      String?  // Cloudinary URL for the event flyer
  organizerName String?  // Custom organizer name entered by the publisher
  status        String   @default("PENDING") // 'PENDING' | 'APPROVED' | 'REJECTED'
  organizerId   Int
  organizer     User     @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Wiki Articles ───────────────────────────────────────────────────────────

model WikiArticle {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  location    String?  // Optional physical location on campus
  imageUrls   String[] @default([])  // Array of Cloudinary URLs
  status      String   @default("PENDING")  // 'PENDING' | 'APPROVED' | 'REJECTED'
  authorId    Int
  author      User     @relation(fields: [authorId], references: [id])
  modNote     String?  // Moderator's internal note
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Art Gallery ─────────────────────────────────────────────────────────────

model GalleryItem {
  id          Int      @id @default(autoincrement())
  title       String
  content     String?          // For poems, stories, text-based creative works
  category    String           // 'DRAWING' | 'POEM' | 'STORY' | 'OTHER'
  imageUrls   String[] @default([])  // Array of Cloudinary URLs
  authorId    Int
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
